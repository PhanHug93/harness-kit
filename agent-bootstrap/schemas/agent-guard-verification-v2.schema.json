{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-bootstrap.local/schemas/agent-guard-verification-v2.schema.json",
  "title": "Agent Guard verification report",
  "description": "Written by agent-guard.sh pre-final --run-verify to .agents/state/last-verify-report.json (or AGENT_GUARD_VERIFY_REPORT_NAME), and by agent-guard.sh baseline to .agents/state/baseline-report.json (with baseline_key and toolchain). unverified means no command ran.",
  "type": "object",
  "required": ["schema", "generated_at", "scope", "source", "commit", "dirty", "status", "summary", "results"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "agent-guard-verification/v2" },
    "generated_at": { "type": "string", "minLength": 1 },
    "scope": { "enum": ["fast", "full"] },
    "source": { "enum": ["contract", "detector"] },
    "commit": { "type": "string", "description": "git rev-parse HEAD at the start of the run; empty when there is none." },
    "dirty": { "type": "boolean" },
    "status": { "enum": ["pass", "fail", "error", "unverified"] },
    "summary": {
      "type": "object",
      "required": ["pass", "fail", "skipped", "error"],
      "additionalProperties": false,
      "properties": {
        "pass": { "type": "integer", "minimum": 0 },
        "fail": { "type": "integer", "minimum": 0 },
        "skipped": { "type": "integer", "minimum": 0 },
        "error": { "type": "integer", "minimum": 0 }
      }
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["command", "source", "status"],
        "additionalProperties": false,
        "properties": {
          "command": { "type": ["string", "null"] },
          "source": { "enum": ["contract", "detector"] },
          "class": { "enum": ["fast", "full"] },
          "status": { "enum": ["pass", "fail", "timeout", "error", "skipped"] },
          "reason": {
            "enum": ["placeholder_or_non_runnable", "discovery", "scope_fast", "budget_exhausted", "unparseable_command", "failed_to_start"]
          },
          "exit_code": { "type": "integer" },
          "duration_ms": { "type": "integer", "minimum": 0 },
          "log_path": { "type": "string", "minLength": 1 },
          "error": { "type": "string" }
        }
      }
    },
    "budget_seconds": { "type": "integer", "minimum": 0, "description": "Total verification budget in seconds the run was given; 0 means unlimited." },
    "error": { "type": "string", "minLength": 1 },
    "baseline_key": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "Baseline only: SHA-256 of HEAD, the contract's verification[] and the toolchain fingerprint; an equal key, scope and clean tree reuse a pass, fail or unverified report."
    },
    "toolchain": {
      "description": "Baseline only: one fingerprint entry per toolchain[] command (\"<command>\\n<exit code, or timeout>\\n<first 2 KB of output>\"), or \"undeclared\" when the contract declares none.",
      "oneOf": [
        { "const": "undeclared" },
        { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      ]
    }
  }
}
