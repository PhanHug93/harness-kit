#!/usr/bin/env bash
# AGENT_BOOTSTRAP_GENERATED
# Portable close-out gate. Runs preflight before fast verification so fresh
# clones have a context pack before pre-final freshness checks.
set -euo pipefail

# The project is two levels up from this hook: the Git top level, or the
# subdirectory the kit is installed in.
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd -P)"
scope="${AGENT_GUARD_PREPUSH_SCOPE:-fast}"
push_input="$(mktemp)"
trap 'rm -f "$push_input"' EXIT HUP INT TERM

if [[ -t 0 ]]; then
  : > "$push_input"
else
  cat > "$push_input"
fi

bash "$ROOT/scripts/agent-local-only-check.sh" pre-push < "$push_input"

# A push that only deletes branches sends no commit: nothing to verify.
if [[ -s "$push_input" ]] && ! awk '$2 !~ /^0+$/ { found = 1 } END { exit !found }' "$push_input"; then
  exit 0
fi

bash "$ROOT/scripts/agent-guard.sh" preflight >/dev/null
# --committed: the tier check reads the commits of the checked-out branch,
# not drafts. Tier checks only recommend; verification can still fail.
exec bash "$ROOT/scripts/agent-guard.sh" pre-final --run-verify --verify-scope "$scope" --committed
